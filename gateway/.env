# PROXY vars. Deprecated
# JWKS_URL=http://auth-service:8180/.well-known/jwks
# in minutes
# JWKS_REFRESH_INTERVAL=30
# LISTEN_ADDR=:8080
# BACKEND_TARGET=http://localhost:4000

APOLLO_ROUTER_HOT_RELOAD=true
APOLLO_ROUTER_INCLUDE_SUBGRAPH_ERRORS=true
APOLLO_ROUTER_LISTEN_ADDRESS=0.0.0.0:4000
APOLLO_ROUTER_HEALTH_CHECK_LISTEN_ADDRESS=0.0.0.0:4000

GATEWAY_SERVICE_PORT=8100
GATEWAY_SERVICE_HOST=gateway-service
# subraph routes for apollo
AUTH_SERVICE_SUBGRAPH=http://${GATEWAY_SERVICE_HOST}:${GATEWAY_SERVICE_PORT}/auth/graphql
ADMINISTRATION_SERVICE_SUBGRAPH=http://${GATEWAY_SERVICE_HOST}:${GATEWAY_SERVICE_PORT}/administration/graphql
APPOINTMENT_SERVICE_SUBGRAPH=http://${GATEWAY_SERVICE_HOST}:${GATEWAY_SERVICE_PORT}/appointment/graphql
BRAND_SERVICE_SUBGRAPH=http://${GATEWAY_SERVICE_HOST}:${GATEWAY_SERVICE_PORT}/brand/graphql
STUDIO_SERVICE_SUBGRAPH=http://${GATEWAY_SERVICE_HOST}:${GATEWAY_SERVICE_PORT}/studio/graphql
USER_SERVICE_SUBGRAPH=http://${GATEWAY_SERVICE_HOST}:${GATEWAY_SERVICE_PORT}/user/graphql

AUTH_SERVICE_HOST=http://auth-service:8180
ADMINISTRATION_SERVICE_HOST=http://administration-service:8181
APPOINTMENT_SERVICE_HOST=http://appointment-service:8182
BRAND_SERVICE_HOST=http://brand-service:8183
STUDIO_SERVICE_HOST=http://studio-service:8184
USER_SERVICE_HOST=http://user-service:8185

THC_PORT=${GATEWAY_SERVICE_PORT}
THC_PATH=/actuator/health/readiness
# database

DBHOST=keycloak_db
DBPORT=5432
DBNAME=keycloak_db

DBUSER=keycloak
DBPASS=keycloak

# keycloak

KC_DB=postgres
KC_DB_URL=jdbc:postgresql://${DBHOST}:${DBPORT}/${DBNAME}
KC_DB_USERNAME=${DBUSER}
KC_DB_PASSWORD=${DBPASS}

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KC_HOSTNAME=keycloak
KC_HEALTH_ENABLED=true
KC_HTTP_ENABLED=true

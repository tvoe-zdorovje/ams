discovery.relabel "apollo_targets" {
  targets = discovery.relabel.common_targets.output

  // filter by 'app' label
  rule {
    source_labels = ["__meta_docker_container_label_app"]
    regex         = "apollo"
    action        = "keep"
  }
}

prometheus.scrape "router" {
  targets           = discovery.relabel.apollo_targets.output
  forward_to        = [prometheus.remote_write.default.receiver]
  job_name          = "apollo"
  metrics_path      = sys.env("ROUTER_METRICS_PATH")
  scrape_interval   = sys.env("SCRAPE_INTERVAL")
  scrape_timeout    = sys.env("SCRAPE_TIMEOUT")
}

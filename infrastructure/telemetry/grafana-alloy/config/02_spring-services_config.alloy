discovery.relabel "spring_boot_targets" {
  targets = discovery.relabel.common_targets.output

  // filter by 'app' label
  rule {
    source_labels = ["__meta_docker_container_label_app"]
    regex         = "spring-boot"
    action        = "keep"
  }
}

prometheus.scrape "spring_boot_services" {
  targets           = discovery.relabel.spring_boot_targets.output
  forward_to        = [prometheus.remote_write.default.receiver]
  job_name          = "spring-boot"
  metrics_path      = sys.env("SPRING_SERVICE_METRICS_PATH")
  scrape_interval   = sys.env("SCRAPE_INTERVAL")
  scrape_timeout    = sys.env("SCRAPE_TIMEOUT")
}

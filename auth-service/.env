# service

SERVER_PORT=8180
THC_PORT=${SERVER_PORT}
THC_PATH=/actuator/health/readiness

ADSDBHOST=administration_db
ADSDBPORT=5432
ADSDBNAME=administration_db
USSDBHOST=user_db
USSDBPORT=5432
USSDBNAME=user_db

DBUSER=ausportal
DBPASS=ausportal

# SPRING_CONFIG_IMPORT="configserver:http://config-server:8888?fail-fast=true&max-attempts=10&max-interval=1500&multiplier=1.2&initial-interval=1100&username=myuser&password=mypass&profile=default&label=master"
SPRING_CONFIG_IMPORT="configserver:http://config-server:8888"
SPRING_CLOUD_CONFIG_FAIL_FAST=true
SPRING_CLOUD_CONFIG_RETRY_MAX_ATTEMPTS=10
SPRING_CLOUD_CONFIG_RETRY_MAX_INTERVAL=15000
SPRING_CLOUD_CONFIG_RETRY_MULTIPLIER=1.2
SPRING_CLOUD_CONFIG_RETRY_INITIAL_INTERVAL=1000
SPRING_CLOUD_CONFIG_LABEL=AUS-6758551 # FIXME change to master

KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_GROUP_ID=auth-service
KAFKA_KEYCLOAK_EVENTS_TOPIC=v1.keycloak.events
KAFKA_KEYCLOAK_EVENTS_LIST=CODE_TO_TOKEN,REFRESH_TOKEN
KAFKA_ADMINISTRATION_USER_EVENTS_TOPIC=v1.administration.user
KAFKA_ADMINISTRATION_USER_EVENTS_LIST=UPDATE_ROLES

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USER_TOKENS_KEY_PREFIX="auth:token:userID:"

JWT_TTL=300000
VAULT_SIZE=1
JWKS_ROTATION_PERIOD=3600000

LOGGING_LEVEL_ROOT=DEBUG

extend type UserMutations {
    createUser(request: CreateUserRequest!): ID!
    updateUser(request: UpdateUserRequest!): ID!
}

input CreateUserRequest { # TODO admin access only
    externalId: String!
    firstName: String!
    lastName: String!
    phoneNumber: String!
}

input UpdateUserRequest {
    firstName: String!
    lastName: String!
    phoneNumber: String!
}

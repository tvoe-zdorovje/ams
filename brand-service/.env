# service

DBHOST=brand_db
DBPORT=5432
DBNAME=brand_db

DBUSER=brsportal
DBPASS=brsportal

SERVER_PORT=8183
THC_PORT=${SERVER_PORT}
THC_PATH=/actuator/health/readiness

# SPRING_CONFIG_IMPORT="configserver:http://config-server:8888?fail-fast=true&max-attempts=10&max-interval=1500&multiplier=1.2&initial-interval=1100&username=myuser&password=mypass&profile=default&label=master"
SPRING_CONFIG_IMPORT="configserver:http://config-server:8888"
SPRING_CLOUD_CONFIG_FAIL_FAST=true
SPRING_CLOUD_CONFIG_RETRY_MAX_ATTEMPTS=10
SPRING_CLOUD_CONFIG_RETRY_MAX_INTERVAL=15000
SPRING_CLOUD_CONFIG_RETRY_MULTIPLIER=1.2
SPRING_CLOUD_CONFIG_RETRY_INITIAL_INTERVAL=1000
SPRING_CLOUD_CONFIG_LABEL=master
LOGGING_LEVEL_ROOT: DEBUG

# postgres

LANG=en_US.utf8
POSTGRES_LOG_STATEMENT=all
POSTGRES_USER=postgres
POSTGRES_PASSWORD=pass
POSTGRES_HOST=${DBHOST}
POSTGRES_PORT=${DBPORT}
# default DB created on start up
POSTGRES_DB=postgres
POSTGRES_DB_NAME=${DBNAME}

# liquibase

LIQUIBASE_COMMAND_URL=jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB_NAME}
LIQUIBASE_COMMAND_USERNAME=brsliquibase
LIQUIBASE_COMMAND_PASSWORD=brsliquibase
LIQUIBASE_COMMAND_CHANGELOG_FILE=changelog.yaml

PGHOST=${POSTGRES_HOST}
PGPORT=${POSTGRES_PORT}
PGUSER=${LIQUIBASE_COMMAND_USERNAME}
PGPASSWORD=${LIQUIBASE_COMMAND_PASSWORD}
PGDATABASE=${POSTGRES_DB_NAME}

# kafka

KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_SCHEMA_REGISTRY_URL=http://schema-registry:8081

KAFKA_BRAND_EVENTS_TOPIC=v1.brands.brand
KAFKA_BRAND_EVENTS_TOPIC_REPLICATION_FACTOR=1
KAFKA_BRAND_EVENTS_TOPIC_PARTITIONS_COUNT=3
